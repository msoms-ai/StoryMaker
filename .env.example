# Qisas AI Image Generation Configuration
# Select your AI provider: 'gemini' | 'dalle3' | 'fal' | 'stability' | 'mock'
AI_IMAGE_PROVIDER=gemini

# 1. Google Gemini / Imagen 3 API Key (Recommended)
# Get your free/paid key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI DALL-E 3 API Key
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 3. Fal.ai / Banana FLUX API Key
# Get your key at: https://fal.ai/dashboard/keys or https://banana.dev
FAL_KEY=your_fal_key_here

# 4. Stability AI API Key
# Get your key at: https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_api_key_here

# Default Art Style Preset
# Options: 'pencil_sketch' | 'watercolor' | '3d_storybook' | 'pencil_color'
IMAGE_STYLE_PRESET=pencil_sketch
